@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ontologiaprueba: <http://example.org/> .
@prefix ex: <http://example.org/shapes/> .

ex:MovieShape
    a sh:NodeShape ;
    sh:targetClass ontologiaprueba:movie1 ;

    sh:property [
        sh:path ontologiaprueba:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;

    sh:property [
        sh:path ontologiaprueba:director ;
        sh:minCount 1 ;
    ] ;

    sh:property [
        sh:path ontologiaprueba:actor ;
        sh:minCount 1 ;
    ] .

ex:PersonShape
    a sh:NodeShape ;
    sh:targetClass ontologiaprueba:actor1 ;

    sh:property [
        sh:path ontologiaprueba:name ;
        sh:minCount 1 ;
    ] ;

    sh:property [
        sh:path ontologiaprueba:birthDate ;
        sh:minCount 1 ;
    ] .