{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "BenthosWorker": {
    "Image": "jeffail/benthos:latest", 
    "PullPolicy": "Never" 
  },
  "ConnectorNamespace": "otv2-test",
  "ReverseProxy": {
    "Routes": {
      "twins-route": {
        "ClusterId": "dapr-sidecar",
        "Match": {
          "Path": "/twins/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/v1.0/invoke/twins-service/method/{**catch-all}"
          }
        ]
      },
      "things-route": {
        "ClusterId": "dapr-sidecar",
        "Match": {
          "Path": "/things/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/v1.0/invoke/things-service/method/{**catch-all}"
          }
        ]
      }
    },
    "Clusters": {
      "dapr-sidecar": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:3501/"
          }
        }
      }
    }
  }
}
